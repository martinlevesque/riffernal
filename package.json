{
  "name": "ironkeys",
  "version": "0.1.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinlevesque/ironkeys.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/martinlevesque/ironkeys/issues"
  },
  "description": "Keyboard Hero - Metal Edition. Play piano along to metal songs.",
  "homepage": "https://github.com/martinlevesque/ironkeys#readme",
  "keywords": [
    "piano",
    "midi",
    "keyboard-hero",
    "metal"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:http": "bun run scripts/dev.ts --http",
    "dev:stop": "pkill -f 'scripts/dev.ts' 2>/dev/null || true",
    "start": "bun run scripts/serve.ts",
    "start:http": "bun run scripts/serve.ts --http",
    "build": "bun run scripts/build.ts",
    "test": "bun x playwright test",
    "test:ui": "bun x playwright test --ui",
    "test:report": "bun x playwright show-report",
    "typecheck": "bun x tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  }
}
